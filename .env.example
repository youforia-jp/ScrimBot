# Statlocker.gg API Key (Optional: fallbacks to 5000 PP / Oracle baseline if omitted)
STATLOCKER_API_KEY=

# Collegiate Team Name (Default: "Texas A&M White")
TEAM_NAME=Texas A&M White

# Request timeout in seconds
HTTP_TIMEOUT=10.0

# Optional Discord Bot Token (for discord_cog)
DISCORD_BOT_TOKEN=
